# Copia este archivo a .env y rellena los valores.
# .env no se sube al repositorio.

# Panel de administración
ADMIN_USER=
ADMIN_PASSWORD=
# Ruta de administración (un segmento: letras, números, - o _). Por defecto topogue.
RUTA_ADMINISTRACION=topogue

# Invitación de la beta. Si está vacío, cualquiera puede entrar.
# El código se pide por email; no se publica.
BETA_INVITE=

# Servidor de señalización
PORT=8787
# En producción detrás de nginx debe ser 127.0.0.1 para no exponer el relé.
HOST=127.0.0.1

# Confía en X-Forwarded-For SOLO detrás de un proxy fiable que la sobrescriba
# (nginx: proxy_set_header X-Forwarded-For $remote_addr). Si el relé está
# expuesto directamente, déjalo sin definir.
# TRUST_PROXY=1

# Orígenes extra permitidos para /admin-api/* además de localhost
# (por ejemplo https://tu-dominio).
# ADMIN_ORIGINS=

# Solo al construir para producción, si la señal no está en el mismo dominio:
# VITE_SIGNAL_URL=wss://tu-dominio/signal/

# Servidor STUN para WebRTC (por defecto stun.cloudflare.com:3478).
# VITE_STUN_URL=stun:tu-servidor:3478
