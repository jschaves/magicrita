# Configuracion del build de Android (APK).
# Se carga con: npm run build:android  ->  vite build --mode android
#
# El rele NO vive dentro del APK: esta en un servidor externo. Aqui solo van
# URLs publicas, ningun secreto.

# Compila sin panel de administracion (el admin es solo web).
VITE_APP_TARGET=android

# Relé de senalizacion (WebSocket) y API HTTP, ambos en el servidor externo.
VITE_SIGNAL_URL=wss://magicrita.com/signal/
VITE_API_BASE=https://magicrita.com

# Servidor STUN de WebRTC (por defecto stun.cloudflare.com:3478).
# VITE_STUN_URL=stun:tu-servidor:3478
